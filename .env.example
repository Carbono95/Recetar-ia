# =====================================
# RecetarIA — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# =====================================

# --- Backend: Database ---
# En desarrollo: SQLite (archivo local, sin dependencias)
DATABASE_URL=sqlite:///./recetaria.db
# En producción (Render): PostgreSQL. No hace falta escribir "+psycopg" a mano:
# database.py normaliza automáticamente "postgres://"/"postgresql://" al driver
# psycopg (v3), que es el que instala requirements.txt.
# DATABASE_URL=postgresql://recetaria:recetaria@localhost:5432/recetaria

# --- Backend: PostgreSQL (usado por docker-compose) ---
POSTGRES_USER=recetaria
POSTGRES_PASSWORD=recetaria
POSTGRES_DB=recetaria

# --- Backend: Security ---
SECRET_KEY=tu-clave-secreta-segura-aqui-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Backend: App ---
ENVIRONMENT=development
DEBUG=True
MEDIA_DIR=./media

# --- Backend: CORS (producción) ---
# URL(s) del frontend en producción, separadas por coma si hay varias
# (p. ej. dominio de Vercel + previews). Vacío en desarrollo: ahí el CORS
# se controla con DEBUG=True en su lugar (ver app/main.py).
CORS_ORIGINS=

# --- Backend: OpenAI (para v2, dejar vacío por ahora) ---
OPENAI_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_ENVIRONMENT=development
